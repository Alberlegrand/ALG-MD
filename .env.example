# Configuration ALG-MD - Assistant WhatsApp
PORT=3000
SESSION_ID=
PAIRING_NUMBER=
MODE=public

# Identifiants Propriétaire
OWNER_NAME=Mr Alberno
OWNER_NUMBER=509444727644
ADMIN_NUMBER=50944727644
PREFIX=.

# Base de Données Supabase (Optionnel mais recommandé pour hébergement cloud)
