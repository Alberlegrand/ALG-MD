REJECT_CALL=false
AUTO_REACT=false
AUTO_STATUS_SEEN=true
AUTO_STATUS_REPLY=false
AUTO_READ=false
AUTO_TYPING=false
AUTO_RECORDING=false
ALWAYS_ONLINE=false
